{
  "buildCommand": "echo 'static site'",
  "outputDirectory": ".",
  "framework": null,
  "rewrites": [
    { "source": "/a-nextep/", "destination": "/a-nextep/index.html" },
    { "source": "/solucoes/", "destination": "/solucoes/index.html" },
    { "source": "/projetos/", "destination": "/projetos/index.html" },
    { "source": "/parcerias/", "destination": "/parcerias/index.html" },
    { "source": "/carreiras/", "destination": "/carreiras/index.html" },
    { "source": "/contato/", "destination": "/contato/index.html" },
    { "source": "/vagas/", "destination": "/vagas/index.html" },
    { "source": "/politica-de-privacidade/", "destination": "/politica-de-privacidade/index.html" },
    { "source": "/termos-de-uso/", "destination": "/termos-de-uso/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ]
}